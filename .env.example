# Frontend Environment Variables (Vite)
# In local development, leave these unset to use Vite's built-in /api and /ws proxy to localhost:5001.
# For production deployment (e.g. Vercel -> Render), set these in your hosting dashboard:

# Base URL of your deployed backend service (without trailing slash)
VITE_API_URL=https://your-backend-service.onrender.com

# Optional explicit WebSocket URL (derived automatically from VITE_API_URL if omitted)
VITE_WS_URL=wss://your-backend-service.onrender.com/ws/focus-room
